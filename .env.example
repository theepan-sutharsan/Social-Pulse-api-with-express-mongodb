# Server
PORT=5000
NODE_ENV=development
DEBUG=1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/social_pulse
# Legacy alias supported by config/env.js
MONGO_URI=

# Authentication and password reset
JWT_SECRET_KEY=change-me
# Legacy alias supported by config/env.js
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES=1440m
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
SECRET_KEY=change-me
PASSWORD_RESET_TOKEN_MAX_AGE=3600

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# YouTube
YOUTUBE_API_KEY=

# Meta / Instagram / Facebook OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/accounts/oauth-callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/accounts/oauth-callback

# AI providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Legacy alias supported by config/env.js
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest

# Transcription and audience intelligence
WHISPER_MODEL=small
AUDIENCE_MAX_COMMENTS=10000
AUDIENCE_COMMENT_BATCH_SIZE=150
